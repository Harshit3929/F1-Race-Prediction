{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/auto-push.sh",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Auto-pushing project to remote..."
          }
        ]
      }
    ]
  }
}
